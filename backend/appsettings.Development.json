{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "VmsBackend": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=visitor_management;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "your-256-bit-secret-key-minimum-32-characters-very-secure-key-here-1234567890",
    "ExpiryMinutes": 30,
    "Issuer": "vms-api",
    "Audience": "vms-frontend"
  },
  "Session": {
    "InactivityTimeoutMinutes": 30,
    "ExtendByMinutes": 30
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "Otp": {
    "ValidMinutes": 10,
    "MaxAttempts": 3,
    "LengthDigits": 6
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SenderEmail": "noreply@visitor-management.local",
    "SenderName": "VMS - Visitor Management System",
    "Username": "local-dev",
    "Password": "local-dev",
    "EnableSsl": false
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecial": true,
    "HistoryCount": 5
  },
  "RateLimiting": {
    "LoginWindowSeconds": 60,
    "LoginMaxRequests": 10
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  }
}
